# setuptools' legacy default happens to pick up tests/test*.py and nothing else,
# so the sdist works today only by luck: the first conftest.py or fixture file
# added would be silently dropped and the shipped sdist would stop being able to
# run its own tests. Be explicit instead.
include LICENSE README.md CHANGELOG.md SECURITY.md contribution-proof.json
recursive-include tests *.py
recursive-include .github *.yml
global-exclude __pycache__ *.py[cod] .DS_Store
